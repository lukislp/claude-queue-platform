# Kopieren nach .env und Werte anpassen, bevor "docker compose up" ausgeführt wird.

# Zufällige, lange Zeichenketten - z.B. mit: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
CLAUDE_KEY_ENCRYPTION_SECRET=change-me-to-a-different-long-random-string

# Nur anpassen, wenn Frontend/Backend nicht auf localhost laufen
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
