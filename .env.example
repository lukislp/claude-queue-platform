# Copy to .env and adjust the values before running "docker compose up".

# Random, long strings - e.g. with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
CLAUDE_KEY_ENCRYPTION_SECRET=change-me-to-a-different-long-random-string

# Only change these if the frontend/backend do not run on localhost
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
